{
  "id": "gnulahd",
  "name": "GnulaHD",
  "version": "8.2.1",
  "apiVersion": 20,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Películas, series y anime en HD desde GnulaHD con audio Latino, Castellano y Subtitulado",
  "author": "JuanDEVYT",
  "hosts": [
    "ww3.gnulahd.nu",
    "vidara.to",
    "savefiles.com",
    "byse.sx",
    "bysevepoin.com",
    "voe.sx",
    "image.tmdb.org",
    "1cloudfile.com",
    "buzzheavier.com"
  ],
  "fetchHosts": "any",
  "streamHosts": "any",
  "browser": true,
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "screen"
  ],
  "screen": {
    "label": "GnulaHD",
    "labelEn": "GnulaHD",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsButton": {
      "label": "Abrir GnulaHD",
      "labelEn": "Open GnulaHD"
    },
    "settingsIn": "screen"
  },
  "categories": [
    "movies",
    "series",
    "anime"
  ],
  "color": "#FF7A18",
  "theme": {
    "accent": "#FF7A18",
    "onAccent": "#0B0D12",
    "background": "#0B0D12",
    "surface": "#11151D",
    "highlight": "#FFAE66"
  },
  "section": {
    "label": "GnulaHD",
    "labelEn": "GnulaHD"
  },
  "settings": [
    {
      "key": "preferredLang",
      "type": "select",
      "label": "Idioma de audio preferido",
      "labelEn": "Preferred audio language",
      "hint": "Selecciona el idioma prioritario al buscar enlaces",
      "hintEn": "Select priority language when fetching links",
      "options": [
        {
          "value": "latino",
          "label": "Latino",
          "labelEn": "Latin Spanish"
        },
        {
          "value": "castellano",
          "label": "Castellano",
          "labelEn": "Castilian Spanish"
        },
        {
          "value": "subtitulado",
          "label": "Subtitulado",
          "labelEn": "Subtitled"
        }
      ],
      "default": "latino"
    }
  ],
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve",
        "normalizeHost",
        "rank"
      ]
    }
  },
  "signature": {
    "authorKey": "0036d8031405ef39f52a4c120617f46a8db166fa23867367f7ae68360f7e31cd",
    "value": "d0dc05454ef6426516fcfc8405cfe7b577ad0657643fae61fb222008ba91f6097453ced3c169d1776a357c2bb5de948c7aed58376d0f5b2ffece190403fce50d"
  }
}
