{
  "id": "gnulahd",
  "name": "GnulaHD",
  "version": "8.0.1",
  "apiVersion": 6,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Películas, series y anime en HD desde GnulaHD con audio Latino, Castellano y Subtitulado",
  "author": "JuanDEVYT",
  "hosts": [
    "ww3.gnulahd.nu",
    "vidara.to",
    "savefiles.com",
    "byse.sx",
    "bysevepoin.com",
    "voe.sx",
    "image.tmdb.org",
    "1cloudfile.com",
    "buzzheavier.com"
  ],
  "streamHosts": "any",
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve"
  ],
  "categories": [
    "movies",
    "series",
    "anime"
  ],
  "color": "#FF7A18",
  "theme": {
    "accent": "#FF7A18",
    "onAccent": "#0B0D12",
    "background": "#0B0D12",
    "surface": "#11151D",
    "highlight": "#FFAE66"
  },
  "section": {
    "label": "GnulaHD",
    "labelEn": "GnulaHD"
  },
  "settings": [
    {
      "key": "preferredLang",
      "type": "select",
      "label": "Idioma de audio preferido",
      "hint": "Selecciona el idioma prioritario al buscar enlaces",
      "options": [
        {
          "value": "latino",
          "label": "Latino"
        },
        {
          "value": "castellano",
          "label": "Castellano"
        },
        {
          "value": "subtitulado",
          "label": "Subtitulado"
        }
      ],
      "default": "latino"
    }
  ],
  "enhancements": {
    "14": {
      "capabilities": [
        "screen"
      ],
      "screen": {
        "label": "GnulaHD",
        "labelEn": "GnulaHD",
        "icon": "movie",
        "menuOpens": "screen",
        "opensFrom": [
          "menu",
          "settings"
        ],
        "settingsButton": {
          "label": "Abrir GnulaHD",
          "labelEn": "Open GnulaHD"
        },
        "settingsIn": "screen"
      }
    },
    "19": {
      "capabilities": [
        "screen"
      ]
    }
  }
}
